# backend/.env.example — sin valores reales. Copiar a backend/.env y rellenar.

# Obligatorias
# En Vercel: la cadena "Transaction pooler" de Supabase (puerto 6543).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/peersync
# Mínimo 32 caracteres. Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ID de cliente OAuth de Google (público, no es un secreto)
GOOGLE_CLIENT_ID=21011797432-8v3d5epni7iolvf79r85q4298hg0gbmo.apps.googleusercontent.com

# Opcionales (valores por defecto)
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Orígenes separados por comas. En Vercel no hace falta: frontend y API comparten dominio.
CORS_ORIGINS=http://localhost:5173
