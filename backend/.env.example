# backend/.env.example — sin valores reales. Copiar a backend/.env y rellenar.

# Obligatorias
# En Vercel: la cadena "Transaction pooler" de Supabase (puerto 6543).
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/peersync

# Clave de Gemini para el apartado Practicar: https://aistudio.google.com/apikey
# Solo en el backend, nunca en el frontend. Sin ella, ese apartado avisa de que no está configurado.
GEMINI_API_KEY=

# Clave de DeepSeek para la IA de la sala (Contrasta, StudyMind y TeachBack): https://platform.deepseek.com/
# Solo en el backend, nunca en el frontend. Sin una clave real, la sala funciona con preguntas preparadas.
DEEPSEEK_API_KEY=TU_DEEPSEEK_API_KEY_AQUI
DEEPSEEK_MODEL=deepseek-flash

# Opcionales (valores por defecto)
# Orígenes separados por comas. En Vercel no hace falta: frontend y API comparten dominio.
CORS_ORIGINS=http://localhost:5173
